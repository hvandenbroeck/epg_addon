{
  "devices": [
    {
      "name": "wp",
      "type": "wp",
      "enable_load_management": false,
      "inside_temp_sensor": "sensor.ebusd_700_z2roomtemp",
      "outside_temp_sensor": "sensor.ebusd_700_displayedoutsidetemp",
      "heatpump_status_sensor": "sensor.ebusd_700_hc2pumpstatus_2",
      "wp_preheat_enabled": true,
      "preheat_max_setpoint": 22.0,
      "preheat_comfort_default_min_temp": 19.5,
      "preheat_comfort_windows": [
        { "start": "23:00", "end": "06:30", "min_temp": 19.5 },
        { "start": "06:30", "end": "08:30", "min_temp": 20.5 },
        { "start": "17:00", "end": "23:00", "min_temp": 20.5 },
        { "start": "08:30", "end": "17:00", "min_temp": 20.5, "days": ["sat", "sun"] }
      ],
      "preheat_setpoint_resolution": 0.5,
      "preheat_penalty_per_c": 0.0,
      "thermal_heat_loss_kw_per_c": 0.024,
      "thermal_heat_capacity_kwh_per_c": 1.5,
      "thermal_max_heat_kw": 5.0,
      "thermal_cop_ref": 3.5,
      "thermal_cop_slope": 0.08,
      "thermal_cop_tout_ref": 7.0,
      "start": {
        "mqtt": [
          {
            "topic": "ebusd/700/z2sfmode/set",
            "topic_get": "ebusd/700/z2sfmode/get",
            "payload": "veto"
          },
          {
            "topic": "ebusd/700/z2quickvetotemp/set",
            "topic_get": "ebusd/700/z2quickvetotemp/get",
            "payload": "{setpoint}"
          }
        ]
      },
      "stop": {
        "mqtt": [
          {
            "topic": "ebusd/700/z2sfmode/set",
            "topic_get": "ebusd/700/z2sfmode/get",
            "payload": "auto"
          },
          {
            "topic": "ebusd/700/z2quickvetotemp/set",
            "topic_get": "ebusd/700/z2quickvetotemp/get",
            "payload": "20"
          }
        ]
      }
    },
    {
      "name": "hw",
      "type": "hw",
      "enable_load_management": false,
      "start": {
        "mqtt": [
          {
            "topic": "ebusd/700/HwcTempDesired/set",
            "topic_get": "ebusd/700/HwcTempDesired/get",
            "payload": "60"
          }
        ]
      },
      "stop": {
        "mqtt": [
          {
            "topic": "ebusd/700/HwcTempDesired/set",
            "topic_get": "ebusd/700/HwcTempDesired/get",
            "payload": "50"
          }
        ]
      }
    },
    {
      "name": "battery",
      "type": "battery",
      "enable_load_management": true,
      "battery_soc_entity": "sensor.deye_battery_soc",
      "battery_capacity_kwh": 10.24,
      "battery_charge_speed_kw": 3.5,
      "battery_min_soc_percent": 20.0,
      "battery_max_soc_percent": 80.0,
      "load_management": {
        "instantaneous_load_entity": "sensor.deye_battery_power",
        "instantaneous_load_entity_unit": "W",
        "load_priority": 1,
        "load_limiter_entity": "select.device_load_limit",
        "load_maximum_watts": "3500",
        "charge_sign": "negative",
        "automated_phase_switching": false,
        "apply_limit_actions": {
          "apply_limit": {
            "entity": [
              {
                "service": "number/set_value",
                "entity_id": "number.deye_battery_max_charge_current",
                "value": "{int(round((limit_watts/51.2), 0))}"
              }
            ]
          }
        }
      },
      "charge_start": {
        "entity": [
          {
            "service": "select/select_option",
            "entity_id": "select.deye_prog1_charge",
            "option": "Allow Grid"
          }
        ]
      },
      "charge_stop": {
        "entity": [
          {
            "service": "select/select_option",
            "entity_id": "select.deye_prog1_charge",
            "option": "No Grid or Gen"
          }
        ]
      },
      "discharge_start": {
        "entity": [
          {
            "service": "number/set_value",
            "entity_id": "number.deye_prog1_capacity",
            "value": 20
          }
        ]
      },
      "discharge_stop": {
        "entity": [
          {
            "service": "number/set_value",
            "entity_id": "number.deye_prog1_capacity",
            "value": 80
          }
        ]
      }
    },
    {
      "name": "ev1",
      "type": "ev",
      "enable_load_management": true,
      "load_management": {
        "instantaneous_load_entity": "sensor.peblar_ev_charger_1_power",
        "instantaneous_load_entity_unit": "W",
        "load_priority": 2,
        "load_limiter_entity": "select.device_load_limit",
        "load_maximum_watts": "7400",
        "charge_sign": "positive",
        "automated_phase_switching": true,
        "apply_limit_actions": {
          "switch_to_single_phase": {
            "entity": [
              {
                "service": "switch/turn_on",
                "entity_id": "switch.peblar_ev_charger_1_force_single_phase"
              }
            ]
          },
          "switch_to_three_phase": {
            "entity": [
              {
                "service": "switch/turn_off",
                "entity_id": "switch.peblar_ev_charger_1_force_single_phase"
              }
            ]
          },
          "apply_limit": {
            "entity": [
              {
                "service": "number/set_value",
                "entity_id": "number.peblar_ev_charger_1_charge_limit",
                "value": "{int(round(limit_watts / (three_phase*400*sqrt(3)+single_phase*230), 0))}"
              }
            ]
          }
        }
      },
      "start": {
        "entity": [
          {
            "service": "switch/turn_on",
            "entity_id": "switch.peblar_ev_charger_1_charging"
          }
        ]
      },
      "stop": {
        "entity": [
          {
            "service": "switch/turn_off",
            "entity_id": "switch.peblar_ev_charger_1_charging"
          }
        ]
      }
    },
    {
      "name": "ev2",
      "type": "ev",
      "enable_load_management": true,
      "load_management": {
        "instantaneous_load_entity": "sensor.peblar_ev_charger_2_power",
        "instantaneous_load_entity_unit": "W",
        "load_priority": 3,
        "load_limiter_entity": "select.device_load_limit",
        "load_maximum_watts": "7400",
        "charge_sign": "positive",
        "automated_phase_switching": true,
        "apply_limit_actions": {
          "switch_to_single_phase": {
            "entity": [
              {
                "service": "switch/turn_on",
                "entity_id": "switch.peblar_ev_charger_2_force_single_phase"
              }
            ]
          },
          "switch_to_three_phase": {
            "entity": [
              {
                "service": "switch/turn_off",
                "entity_id": "switch.peblar_ev_charger_2_force_single_phase"
              }
            ]
          },
          "apply_limit": {
            "entity": [
              {
                "service": "number/set_value",
                "entity_id": "number.peblar_ev_charger_2_charge_limit",
                "value": "{int(round(limit_watts / (three_phase*400*sqrt(3)+single_phase*230), 0))}"
              }
            ]
          }
        }
      },
      "start": {
        "entity": [
          {
            "service": "switch/turn_on",
            "entity_id": "switch.peblar_ev_charger_2_charging"
          }
        ]
      },
      "stop": {
        "entity": [
          {
            "service": "switch/turn_off",
            "entity_id": "switch.peblar_ev_charger_2_charging"
          }
        ]
      }
    }
  ]
}
